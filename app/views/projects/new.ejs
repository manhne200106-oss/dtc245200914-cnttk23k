<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content container form-container">
  <%- include('../partials/alerts') %>

  <nav class="breadcrumb">
    <a href="/">Dashboard</a> &raquo;
    <a href="/projects">Dự án</a> &raquo;
    <span>Tạo mới</span>
  </nav>

  <div class="card">
    <div class="card-header">
      <h1 class="card-title">Tạo Dự Án Mới</h1>
    </div>
    <div class="card-body">
      <form action="/projects" method="POST">
        <div class="form-group">
          <label for="name" class="form-label required">Tên Dự Án:</label>
          <input
            type="text"
            name="name"
            id="name"
            class="form-control"
            placeholder="Ví dụ: Nền tảng E-Commerce..."
            value="<%= project.name || '' %>"
            required
            maxlength="150"
          >
          <small class="form-text">Tối đa 150 ký tự.</small>
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Mô Tả Dự Án:</label>
          <textarea
            name="description"
            id="description"
            rows="4"
            class="form-control"
            placeholder="Mô tả mục tiêu, phạm vi và công nghệ dự kiến..."
          ><%= project.description || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="status" class="form-label required">Trạng Thái Ban Đầu:</label>
          <select name="status" id="status" class="form-control" required>
            <option value="PLANNING" <%= (project.status === 'PLANNING' || !project.status) ? 'selected' : '' %>>Lập kế hoạch (PLANNING)</option>
            <option value="IN_PROGRESS" <%= project.status === 'IN_PROGRESS' ? 'selected' : '' %>>Đang thực hiện (IN_PROGRESS)</option>
            <option value="COMPLETED" <%= project.status === 'COMPLETED' ? 'selected' : '' %>>Hoàn thành (COMPLETED)</option>
            <option value="ON_HOLD" <%= project.status === 'ON_HOLD' ? 'selected' : '' %>>Tạm hoãn (ON_HOLD)</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Lưu Dự Án</button>
          <a href="/projects" class="btn btn-outline">Hủy Bỏ</a>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
