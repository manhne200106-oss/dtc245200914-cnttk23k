<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content container error-page-container">
  <div class="card error-card">
    <div class="error-code">404</div>
    <h1 class="error-title">Không Tìm Thấy Trang</h1>
    <p class="error-message"><%= typeof message !== 'undefined' ? message : 'Đường dẫn bạn yêu cầu không tồn tại trên hệ thống.' %></p>
    <% if (typeof path !== 'undefined') { %>
      <p class="error-path">Đường dẫn: <code><%= path %></code></p>
    <% } %>
    <div class="error-actions">
      <a href="/" class="btn btn-primary">Quay Về Trang Chủ</a>
      <a href="/projects" class="btn btn-outline">Xem Danh Sách Dự Án</a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
