# Node environment & server port
NODE_ENV=development
PORT=3000

# PostgreSQL database configuration
POSTGRES_DB=project_management
POSTGRES_USER=project_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# DB Connection Host for Docker container (service name 'postgres')
DB_HOST=postgres
DB_PORT=5432

# pgAdmin configuration
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here

# Nginx reverse proxy configuration
# (Port 8080 is often used by existing web containers; 8081 provides a clean, conflict-free port)
NGINX_PORT=8081

# Prometheus & Grafana monitoring configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Loki & Promtail centralized logging configuration
LOKI_PORT=3100
